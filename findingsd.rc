#!/bin/ksh
#

daemon="/usr/local/sbin/findingsd"

. /etc/rc.d/rc.subr

rc_reload=NO

# At boot mysqld may still be starting. Wait up to 60s for the database
# to answer before launching findingsd, instead of failing straight away.
rc_pre() {
	local _admin _host _i=0
	_admin=$(command -v mariadb-admin || command -v mysqladmin) || return 0
	_host=$(print -- "${daemon_flags}" | sed -n 's/.*-h *\([^ ]*\).*/\1/p')
	while ! ${_admin} ${_host:+-h ${_host}} --connect-timeout=2 ping \
	    >/dev/null 2>&1; do
		_i=$((_i + 1))
		[ ${_i} -ge 60 ] && return 1
		sleep 1
	done
}

rc_cmd $1
